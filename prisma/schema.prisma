generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]

  @@index([email])
}

model Order {
  id             String   @id @default(uuid())
  orderId        String
  warehouseCode  String
  shipToName     String
  shipToState    String
  phoneNumber    String
  sku            String
  orderPlaceDate DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([orderId, sku])
  @@index([orderId])
  @@index([warehouseCode])
  @@index([shipToState])
  @@index([sku])
  @@index([orderPlaceDate])
  @@index([userId])
}
